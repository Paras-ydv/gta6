# Upstash Redis (console.upstash.com -> your database -> REST API section)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public URL of the site, no trailing slash. Used in share links and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: secret salt for hashing IPs. Falls back to the Upstash token.
IP_SALT=

# Optional: a background clip YOU have the rights to (e.g. your own gameplay recording).
# Put it in /public (e.g. /bg.mp4, H.264, muted, ~10-20s, <8MB) or on a CDN. Unset = official YouTube trailer.
NEXT_PUBLIC_BG_VIDEO_URL=
NEXT_PUBLIC_BG_VIDEO_POSTER=
