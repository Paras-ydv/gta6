# Upstash Redis (console.upstash.com -> your database -> REST API section)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public URL of the site, no trailing slash. Used in share links and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: secret salt for hashing IPs. Falls back to the Upstash token.
IP_SALT=
